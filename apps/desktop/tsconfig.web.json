{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@owncoder/shared": ["../../packages/shared/src/index.ts"],
      "@owncoder/settings": ["../../packages/settings/src/index.ts"],
      "@owncoder/llm/browser": ["../../packages/llm/src/browser.ts"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.ts"],
  "exclude": ["src/renderer/src/**/*.test.ts", "src/renderer/src/**/*.test.tsx"]
}
