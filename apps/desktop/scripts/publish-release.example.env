# 发布环境变量样例。复制为 `.env` 或 `publish-release.env` 后填入实际值。
# 真实凭据请勿提交到 git。

# ── 阿里云 OSS / 腾讯 COS（必填）─────────────────────────────────────────────
# 推荐用 RAM 子账号 AccessKey，只授权 oss:PutObject 到目标桶。
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# 桶名（不带 endpoint 后缀）
OSS_BUCKET=owncoder-releases

# Region 和 Endpoint
# 阿里云杭州：oss-cn-hangzhou / oss-cn-hangzhou.aliyuncs.com
# 阿里云北京：oss-cn-beijing / oss-cn-beijing.aliyuncs.com
# 腾讯云上海：cos.ap-shanghai / cos.ap-shanghai.myqcloud.com
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 桶内目录前缀。默认 owncoder。
# 最终 URL 形如：https://<bucket>.<endpoint>/<prefix>/<version>/<file>
OSS_PATH_PREFIX=owncoder

# ── Gitee release 上传（可选；不填就跳过）───────────────────────────────────
# 在 https://gitee.com/profile/personal_access_tokens 生成，勾上 projects + releases。
GITEE_TOKEN=

# Gitee 仓库（默认值已对应当前项目，按需改）
GITEE_OWNER=f6688
GITEE_REPO=owncoder

# ── 依赖说明 ────────────────────────────────────────────────────────────────
# 这个脚本会按以下顺序尝试上传工具：
#   1. ali-oss（推荐）：npm i -g ali-oss 或在项目里 devDep 安装
#   2. ossutil CLI（阿里云官方 CLI）：从 https://help.aliyun.com/document_detail/120075.html 下载
# 两者都缺会上传失败；至少装一个。